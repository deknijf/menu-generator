# Kopieer naar .env. Dit bestand is gitignored en wordt in productie als volume
# gemount (zie docker-compose.yml), zodat de admin-UI erin kan blijven schrijven.

APP_SECRET_KEY=replace-with-random-secret
FLASK_DEBUG=false

# Zet op false om lokaal over http te kunnen inloggen. In productie aan laten:
# zonder Secure-vlag kan de sessiecookie over een onversleutelde verbinding lekken.
SESSION_COOKIE_SECURE=true

# DEBUG, INFO, WARNING of ERROR. Logs gaan naar stdout en dus naar journalctl.
LOG_LEVEL=INFO

# OpenRouter. Deze waarden worden ook via de Admin-tab in de app beheerd; wat je
# daar opslaat wordt naar dit bestand geschreven.
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=replace-with-openrouter-token
OPENROUTER_MODEL=openai/gpt-4o-mini
MENU_AI_PROMPT=Genereer praktische Europese avondmaaltijden met weinig ingredienten.
MENU_AI_BLOCKED_ALLERGIES=peanut,shellfish
